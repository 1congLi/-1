{
  "name": "heima-accounting",
  "version": "1.0.0",
  "description": "黑马记账 - 个人消费记录应用",
  "main": "./dist-electron/main.js",
  "author": "Heima",
  "license": "MIT",
  "scripts": {
    "dev": "node dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "node dev.js",
    "electron:dist": "electron .",
    "electron:run": "node dist-electron/electron.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dayjs": "^1.11.10",
    "echarts": "^5.4.3",
    "element-plus": "^2.5.0",
    "exceljs": "^4.4.0",
    "pinia": "^2.1.7",
    "recharts": "^3.10.1",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.0"
  },
  "build": {
    "appId": "com.heima.accounting",
    "productName": "黑马记账",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.finance"
    }
  }
}
